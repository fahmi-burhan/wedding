# .env.example — contoh pengaturan. Salin menjadi .env lalu sesuaikan:
#   Copy-Item .env.example .env
# File .env TIDAK boleh di-commit (berisi rahasia).

# Port & alamat server. Di VPS (di belakang Nginx) gunakan HOST=127.0.0.1.
PORT=4234
HOST=0.0.0.0

# Alamat publik undangan TANPA garis miring di akhir. Dipakai untuk tautan tamu & gambar pratinjau WhatsApp.
# Contoh produksi: PUBLIC_BASE_URL=https://undangan.domainanda.id
PUBLIC_BASE_URL=http://wedding.sahoor.cloud

# Diisi otomatis oleh: npm run admin:password
ADMIN_PASSWORD_HASH=
IP_SALT=

# Lokasi berkas database (default: data/wedding.db).
# DB_PATH=

# Isi "loopback" bila server berjalan di belakang Nginx di mesin yang sama.
# TRUST_PROXY=loopback

# Isi "production" di VPS (cookie admin hanya lewat HTTPS).
# NODE_ENV=production
