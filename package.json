{
  "name": "undangan-walimah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Undangan digital walimah dengan RSVP (Express + SQLite + Vue)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "admin:password": "node --env-file-if-exists=.env scripts/admin-password.ts",
    "guests:import": "node --env-file-if-exists=.env scripts/guests-import.ts",
    "guests:links": "node --env-file-if-exists=.env scripts/guest-links.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.ts",
    "ornaments": "node scripts/generate-ornaments.ts",
    "og:image": "node scripts/og-image.ts",
    "assets": "node scripts/process-assets.ts",
    "scenes": "node scripts/generate-scenes.ts",
    "calligraphy": "node scripts/generate-calligraphy.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
